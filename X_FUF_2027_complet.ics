DTSTART;TZID=Europe/Paris:20260914T185000
DTEND;TZID=Europe/Paris:20260914T200000
DTSTAMP:20260809T120000Z
UID:c4d1ffa29a7d97236274a535e3a69748@fuf-romain
SEQUENCE:4
