DTSTART;TZID=Europe/Paris:20261021T183000
DTEND;TZID=Europe/Paris:20261021T200000
DTSTAMP:20260809T120000Z
UID:2d675ea0229852d8ba0f678b33ddaaf1@fuf-romain
SEQUENCE:4
DESCRIPTION:C'est ce qui te fera tenir huit mois. Ne le remplis pas.
