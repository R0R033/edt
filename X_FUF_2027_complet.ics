SUMMARY:REPOS PROTEGE - ne rien planifier
DTSTART;TZID=Europe/Paris:20260916T183000
DTEND;TZID=Europe/Paris:20260916T200000
DTSTAMP:20260809T120000Z
UID:9dd87449b9f18f5452358e67847328e8@fuf-romain
